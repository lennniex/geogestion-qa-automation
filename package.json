{
  "name": "geogestion-qa-automation",
  "version": "1.0.0",
  "description": "Prueba técnica QA - GoDoWorks GeoGestión: flujo Soluciones > GDW Health > Solicita una Demo (Playwright + TypeScript)",
  "author": "Lennin Alexander Martinez",
  "license": "MIT",
  "private": true,
  "scripts": {
    "setup": "playwright install chromium ffmpeg",
    "test": "playwright test --project=chrome",
    "test:captcha": "playwright test --project=chrome-captcha",
    "test:flujo": "playwright test tests/e2e/solicitud-demo-gdw-health.spec.ts --project=chrome",
    "test:bugs": "playwright test tests/e2e/hallazgos-regresion.spec.ts --project=chrome",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports/playwright-html",
    "codegen": "playwright codegen https://www.godoworks.com/soluciones/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "docx": "^9.0.0"
  }
}
